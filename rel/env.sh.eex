# Sourced by bin/opensauce for every command (start, eval, remote).
#
# The nix-built release lives in the read-only store, so the release script
# can neither read a build-time releases/COOKIE (mixRelease strips it for
# reproducibility) nor write one. Derive a stable node cookie from
# SECRET_KEY_BASE — always set in prod — unless one is provided explicitly.
if [ -z "${RELEASE_COOKIE:-}" ] && [ -n "${SECRET_KEY_BASE:-}" ]; then
  RELEASE_COOKIE=$(printf '%s' "$SECRET_KEY_BASE" | tr -dc 'A-Za-z0-9' | cut -c1-48)
  export RELEASE_COOKIE
fi

# The minimal nix image ships no locale data, so the VM defaults to latin1
# filename encoding — bad for the uploads path. Force UTF-8 filename mode.
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} +fnu"
