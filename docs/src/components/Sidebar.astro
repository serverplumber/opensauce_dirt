---
const current = Astro.url.pathname;

const sections = [
  {
    heading: "Getting Started",
    items: [
      { label: "Introduction", href: "/docs/" },
      { label: "Development", href: "/docs/getting-started/" },
    ],
  },
  {
    heading: "Architecture",
    items: [
      { label: "Domains", href: "/docs/domains/" },
      { label: "Data Model & Calculations", href: "/docs/data-model/" },
    ],
  },
  {
    heading: "Feature Guides",
    items: [
      { label: "Customers & Engagements", href: "/docs/customers/" },
      { label: "Jobs & Scheduling", href: "/docs/orders/" },
      { label: "Inventory", href: "/docs/inventory/" },
      { label: "Purchasing", href: "/docs/purchasing/" },
      { label: "Invoicing & Costing", href: "/docs/production-batching/" },
      { label: "Settings & Organisation", href: "/docs/settings/" },
    ],
  },
  {
    heading: "API",
    items: [
      { label: "REST Reference", href: "/docs/api/" },
      { label: "GraphQL Reference", href: "/docs/graphql/" },
    ],
  },
];

function active(href: string) {
  return current === href || current === href.replace(/\/$/, "");
}
---

<nav class="flex flex-col gap-5">
  {sections.map((s) => (
    <div>
      <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-stone-400">{s.heading}</p>
      <ul class="space-y-0.5">
        {s.items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "block px-2 py-1 text-sm",
                active(item.href)
                  ? "font-medium text-stone-900"
                  : "text-stone-500 hover:text-stone-900",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
