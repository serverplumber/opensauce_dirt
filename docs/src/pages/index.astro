---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="OpenSauce">
  <div class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-2xl font-semibold text-stone-900">OpenSauce</h1>
    <p class="mt-3 text-stone-500">
      Open-source ERP for small-scale manufacturers. Built on Ash Framework,
      Phoenix LiveView, and PostgreSQL.
    </p>
    <div class="mt-8 flex gap-4 text-sm">
      <a href="/docs/" class="font-medium text-stone-900 underline">Documentation</a>
      <a href="/docs/api/" class="font-medium text-stone-900 underline">API Reference</a>
      <a href="/docs/self-hosting/" class="font-medium text-stone-900 underline">Self-Hosting</a>
    </div>
  </div>
</BaseLayout>
