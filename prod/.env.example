# Copy this file to .env.preprod or .env.prod and fill in every value.
# The app will refuse to start if any required variable is missing.

# ── Database ──────────────────────────────────────────────────────────────────
# Database name: opensauce_preprod for preprod, opensauce_prod for prod.
# Password must match POSTGRES_PASSWORD below.
DATABASE_URL=ecto://postgres:CHANGE_ME@localhost/opensauce_preprod

# Password for the postgres container. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# ── Required secrets ──────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
SECRET_KEY_BASE=

# Generate: openssl rand -base64 32
TOKEN_SIGNING_SECRET=

# AES encryption key — must be exactly 32 bytes before base64 encoding.
# Generate: openssl rand -base64 32
CLOAK_KEY=

# ── Network ───────────────────────────────────────────────────────────────────
# Public hostname without scheme or port. Used for URL generation (emails, etc).
HOST=app.example.com

# Port the app listens on inside the pod. 4000 is the default.
PORT=4000

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins. Leave blank to disable CORS headers.
# CORS_ORIGINS=https://app.example.com

# Directory for uploaded files inside the container.
# Mount a volume here if you want uploads to survive container restarts.
UPLOAD_DIR=/var/lib/opensauce/uploads

# Email provider: sendgrid | postmark | brevo | mailgun | amazon_ses
# Leave blank to log emails to stdout instead of sending them.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM_NAME=OpenSauce
# EMAIL_FROM_ADDRESS=noreply@example.com
